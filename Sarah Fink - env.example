# .env.example - template. Copy to ".env" and fill in your values.
# Everything runs locally in docker compose (frontend, backend, MongoDB container).
# Variable names are examples: use your own, as long as docker-compose.yml reads them.

# MongoDB container. Use the SERVICE NAME from docker-compose.yml as the host
# (here "mongo"), NOT localhost: inside a container, localhost is the container itself.
MONGODB_URI=mongodb://mongo:27017
DB_NAME=focusflow

# Optional, for stronger security: a secret to sign login tokens
# (any long random string). Not required.
# JWT_SECRET=change-me-to-a-long-random-string

# Optional: only if your project uses Gemini. Submit it EMPTY.
# The site must still work (and fail politely) without it.
GEMINI_API_KEY=
