# קבצים ותיקיות שלא נשלחים ל-Docker בזמן הבנייה, ולכן לא ייכנסו לתמונה.
# קובץ הסודות המקומי – אסור שייכנס לתמונה ציבורית
.env
# כל קבצי .env אחרים (למשל .env.local)
.env.*
# קבצי פייתון מהודרים שנוצרים אוטומטית
__pycache__
*.pyc
# cache של pytest
.pytest_cache
# הטסטים לא נחוצים בזמן ריצה
tests
# הסביבה הווירטואלית המקומית (הספריות מותקנות מחדש בתוך התמונה)
.venv
