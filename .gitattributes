# איך גיט מטפל בסופי שורות ובקבצים בינאריים.
# קבצי טקסט: גיט מזהה לבד ושומר אותם בריפו עם LF
* text=auto
# סקריפטים והגדרות nginx רצים בתוך קונטיינרים של לינוקס: תמיד LF (תו CR מ-Windows שובר אותם)
*.sh text eol=lf
*.conf text eol=lf
# קבצי env: תו CR היה הופך לחלק מהערך
.env.example text eol=lf
.env.template text eol=lf
# קבצים בינאריים – גיט לא נוגע בהם ולא מנסה להציג הבדלים
*.onnx binary
*.task binary
*.pdf binary
*.docx binary
