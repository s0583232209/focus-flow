# דוגמה למשתני הסביבה. מעתיקים ל-.env (cp .env.example .env) – הקובץ .env לא נכנס לגיט.
# כאן רק ערכי דוגמה, אף פעם לא סודות אמיתיים. ההערות בשורות נפרדות, כי הערה בסוף שורה עלולה להפוך לחלק מהערך.
# כתובת המסד. בתוך Docker משתמשים בשם השירות mongodb, לא ב-localhost (שהוא הקונטיינר עצמו)
MONGO_URL=mongodb://mongodb:27017
# שם המסד
MONGO_DB=focusflow
# סוד חתימת הטוקנים – בקובץ .env האמיתי מחרוזת אקראית של לפחות 32 תווים
JWT_SECRET=change-me-to-a-long-random-string
# תוקף הטוקן בדקות
JWT_EXPIRE_MINUTES=60
# האתרים שמותר להם לפנות לשרת: 3000 (Docker) ו-5173 (npm run dev)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# הכתובת שהדפדפן משתמש בה כדי לפנות לשרת
API_URL=http://localhost:8000
# מפתח Gemini (בונוס) – ריק = כבוי
GEMINI_API_KEY=
