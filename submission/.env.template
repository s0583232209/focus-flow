# JWT_SECRET is a one-time random value for local grading only
# תבנית ל-.env שמוגש לבודק. scripts/make-submission.sh יוצר ממנה את submission/.env:
# הוא מחליף את DOCKER_USER ואת JWT_SECRET בערכים אמיתיים (סוד חד-פעמי חדש בכל הרצה).
# שם המשתמש ב-Docker Hub שממנו נמשכות התמונות
DOCKER_USER=DOCKER_USER_PLACEHOLDER
# המסד רץ בקונטיינר בשם mongodb
MONGO_URL=mongodb://mongodb:27017
MONGO_DB=focusflow
# יוחלף במחרוזת אקראית
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=60
# אצל הבודק האתר רץ רק על פורט 3000
CORS_ORIGINS=http://localhost:3000
API_URL=http://localhost:8000
# ריק בהגשה – הסיכום האוטומטי כבוי
GEMINI_API_KEY=
